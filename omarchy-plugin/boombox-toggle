#!/usr/bin/env bash

# Query Hyprland for active window and BOOMBOX / Hip-Hop Radio window
MODE="focus"
if [[ "$1" == "--toggle" || "$1" == "-t" ]]; then
  MODE="toggle"
fi

ACTIVE_ADDR=$(hyprctl activewindow -j 2>/dev/null | jq -r '.address // empty')

WINDOW_ADDR=$(hyprctl clients -j 2>/dev/null | jq -r '
  map(select(
    ((.class // "") | test("boombox|hiphop-radio"; "i")) or
    ((.initialClass // "") | test("boombox|hiphop-radio"; "i")) or
    ((.title // "") | test("BOOMBOX|NEON//WAVE|Hip-Hop Radio"; "i")) or
    ((.initialTitle // "") | test("BOOMBOX|boombox|hiphop-radio|Hip-Hop Radio"; "i"))
  )) | .[0].address // empty
')

WINDOW_WS=$(hyprctl clients -j 2>/dev/null | jq -r '
  map(select(
    ((.class // "") | test("boombox|hiphop-radio"; "i")) or
    ((.initialClass // "") | test("boombox|hiphop-radio"; "i")) or
    ((.title // "") | test("BOOMBOX|NEON//WAVE|Hip-Hop Radio"; "i")) or
    ((.initialTitle // "") | test("BOOMBOX|boombox|hiphop-radio|Hip-Hop Radio"; "i"))
  )) | .[0].workspace.name // empty
')

CURRENT_WS=$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.name // .id // "1"')

focus_window() {
  local addr="$1"
  hyprctl dispatch "hl.dsp.focus{ window = \"address:$addr\" }" >/dev/null 2>&1 || \
  hyprctl dispatch focuswindow "address:$addr" >/dev/null 2>&1
}

move_window_to_workspace() {
  local ws="$1"
  local addr="$2"
  hyprctl dispatch "hl.dsp.window.move{ workspace = \"$ws\", window = \"address:$addr\" }" >/dev/null 2>&1 || \
  hyprctl dispatch movetoworkspace "$ws,address:$addr" >/dev/null 2>&1
}

move_window_to_scratchpad() {
  local addr="$1"
  hyprctl dispatch "hl.dsp.window.move{ workspace = \"special:boombox\", window = \"address:$addr\", silent = true }" >/dev/null 2>&1 || \
  hyprctl dispatch movetoworkspacesilent "special:boombox,address:$addr" >/dev/null 2>&1
}

if [[ -n "$WINDOW_ADDR" && "$WINDOW_ADDR" != "null" ]]; then
  if [[ "$MODE" == "toggle" && "$ACTIVE_ADDR" == "$WINDOW_ADDR" ]]; then
    # In explicit toggle mode (e.g. keyboard shortcut) when already focused -> minimize to scratchpad
    move_window_to_scratchpad "$WINDOW_ADDR"
  else
    # In focus mode (Tray click / AppMenu / Bar Widget) or when window was hidden/unfocused:
    # Bring window to active workspace and focus it immediately
    if [[ "$WINDOW_WS" == special:* || "$WINDOW_WS" != "$CURRENT_WS" ]]; then
      move_window_to_workspace "$CURRENT_WS" "$WINDOW_ADDR"
    fi
    focus_window "$WINDOW_ADDR"
  fi
else
  # No window running -> launch in default terminal
  BIN_CMD="boombox"
  if ! command -v boombox >/dev/null 2>&1; then
    BIN_CMD="hiphop-radio"
  fi

  if command -v xdg-terminal-exec >/dev/null 2>&1; then
    exec xdg-terminal-exec --app-id=boombox --title="BOOMBOX RX-505" "$BIN_CMD"
  elif command -v foot >/dev/null 2>&1; then
    exec foot --app-id=boombox --title="BOOMBOX RX-505" "$BIN_CMD"
  elif command -v ghostty >/dev/null 2>&1; then
    exec ghostty --class=boombox --title="BOOMBOX RX-505" -e "$BIN_CMD"
  elif command -v alacritty >/dev/null 2>&1; then
    exec alacritty --class boombox,boombox -T "BOOMBOX RX-505" -e "$BIN_CMD"
  else
    exec "$BIN_CMD"
  fi
fi
